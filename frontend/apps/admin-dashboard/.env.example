# ---------------------------------------------------------------------------
# Admin dashboard (Next.js) - environment template
#
# Copy to the environment you want to run, e.g.:
#
#   cp .env.example .env.development
#
# Every value below is a dummy placeholder. Never commit a populated env file.
# ---------------------------------------------------------------------------

# Base URL of the API service, including the /api prefix.
NEXT_PUBLIC_BASE_URL="http://localhost:5000/api"

# --- NextAuth --------------------------------------------------------------
# Generate the secret with: openssl rand -base64 32
NEXTAUTH_URL="http://localhost:3002"
NEXTAUTH_SECRET="replace_with_random_secret"

# --- Google OAuth provider (optional) --------------------------------------
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# --- Google Maps (optional) ------------------------------------------------
NEXT_PUBLIC_GOOGLE_MAP_API_KEY=""
