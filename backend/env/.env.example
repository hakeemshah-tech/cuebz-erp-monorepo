# ---------------------------------------------------------------------------
# API service - environment template
#
# The server loads ./env/.env.<NODE_ENV> (see app.js). Copy this file to the
# environment you want to run, e.g.:
#
#   cp env/.env.example env/.env.development
#
# Every value below is a dummy placeholder. Never commit a populated env file.
# ---------------------------------------------------------------------------

NODE_ENV="development"
PORT=5000

# --- Database --------------------------------------------------------------
MONGO_DB_URI="mongodb://127.0.0.1:27017/enterprise_erp"

# --- Auth / sessions -------------------------------------------------------
# Generate each of these with: openssl rand -hex 32
ACCESS_TOKEN_SECRET="replace_with_random_secret"
REFRESH_TOKEN_SECRET="replace_with_random_secret"
JWT_SECRET="replace_with_random_secret"
SESSION_SECRET="replace_with_random_secret"

# --- First-run super admin seed (seeds/superAdminSeed.js) ------------------
SEED_ADMIN_USERNAME="superadmin"
SEED_ADMIN_EMAIL="admin@example.com"
SEED_ADMIN_PASSWORD="change_me"

# --- Redis (BullMQ queues, reminder workers, session store) ----------------
REDIS_CONNECT_HOST="127.0.0.1"
REDIS_CONNECT_PORT=6379
REDIS_CONNECT_PASSWORD=""

# --- Stripe billing --------------------------------------------------------
# Use test-mode keys locally: https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY="placeholder_for_stripe_secret"
STRIPE_WEBHOOK_SECRET="placeholder_for_webhook_secret"
STRIPE_WEBHOOK_SECRET_LIVE="placeholder_for_live_webhook_secret"

# --- Outbound email (nodemailer) -------------------------------------------
EMAIL="no-reply@example.com"
EMAIL_PASSWORD="change_me"

# --- Application-layer encryption ------------------------------------------
# ENCRYPTION_KEY / ENCRYPTION_KEY_CREDENTIALS: 32-byte keys as 64 hex chars
# ENCRYPTION_IV: 16-byte IV as 32 hex chars
ENCRYPTION_KEY="0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"
ENCRYPTION_KEY_CREDENTIALS="0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"
ENCRYPTION_IV="0123456789abcdef0123456789abcdef"

# --- Media storage ---------------------------------------------------------
CLOUDINARY_CLOUD_NAME="your_cloud_name"
CLOUDINARY_API_KEY="placeholder_cloudinary_api_key"
CLOUDINARY_API_SECRET="placeholder_cloudinary_api_secret"

AWS_ACCESS_KEY_ID="placeholder_aws_access_key"
AWS_SECRET_ACCESS_KEY="placeholder_aws_secret_key"
AWS_S3_BUCKET_NAME="your-bucket-name"
AWS_REGION="us-east-1"

# --- CORS / frontend origins ----------------------------------------------
CORS_ORIGIN="http://localhost:3002"
FRONTEND_URL="http://localhost:3002"
FRONTEND_WEB_URL="http://localhost:3005"
FRONTEND_URL_LIVE="https://app.example.com"
FRONTEND_WEB_URL_LIVE="https://www.example.com"